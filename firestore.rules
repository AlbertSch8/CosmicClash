rules_version = '2';
// UFO: Cosmic Clash — Firestore Security Rules
// Autor: Alexandre Basseville

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Veřejné profily uživatelů ────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null && request.auth.uid == userId;
    }

    // ── Herní profily ufonů ──────────────────────────────────────────────
    // Čtení necháváme pro všechny přihlášené hráče kvůli battle matchmakingu.
    match /aliens/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null
                    && request.auth.uid == userId;
    }

    // ── Tréninkové session ───────────────────────────────────────────────
    match /trainingSessions/{sessionId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      allow read, update: if request.auth != null
                          && resource.data.userId == request.auth.uid;
    }

    // ── Záznamy soubojů ──────────────────────────────────────────────────
    match /battles/{battleId} {
      allow create: if request.auth != null
                    && request.resource.data.attackerId == request.auth.uid;

      allow read: if request.auth != null
                  && (
                    resource.data.attackerId == request.auth.uid
                    || resource.data.defenderId == request.auth.uid
                  );
    }

    // ── Shop itemy ───────────────────────────────────────────────────────
    match /items/{itemId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Inventář hráče ───────────────────────────────────────────────────
    match /inventory/{inventoryId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      allow read, update: if request.auth != null
                          && resource.data.userId == request.auth.uid;
    }

    // ── Výchozí: vše ostatní zakázáno ────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}