rules_version = '2';
// UFO: Cosmic Clash — Firestore Security Rules
// Autor: Alexandre Basseville

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Herní profily ufonů ──────────────────────────────────────────────
    // Každý hráč smí číst a zapisovat pouze svůj dokument.
    // VÝJIMKA pro čtení: ostatní hráči potřebují číst profily soupeřů
    // pro matchmaking — ale jen pole level, name, hp, dmg, stamina.
    // Firestore neumí field-level read rules → povolíme read pro všechny
    // autentizované uživatele (profil neobsahuje citlivá data mimo email).
    match /aliens/{userId} {
      // Číst profil smí každý přihlášený (potřeba pro matchmaking soupeřů)
      allow read: if request.auth != null;
      // Zapisovat smí pouze vlastník svého dokumentu
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Tréninkové session ───────────────────────────────────────────────
    match /trainingSessions/{sessionId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read, update: if request.auth != null
                          && resource.data.userId == request.auth.uid;
    }

    // ── Záznamy soubojů ──────────────────────────────────────────────────
    // Hráč smí vytvořit souboj kde je útočníkem (attackerId == jeho UID).
    // Číst smí souboje kde byl útočníkem nebo obráncem.
    match /battles/{battleId} {
      allow create: if request.auth != null
                    && request.resource.data.attackerId == request.auth.uid;
      allow read: if request.auth != null
                  && (resource.data.attackerId == request.auth.uid
                      || resource.data.defenderId == request.auth.uid);
    }

    // ── Výchozí: vše ostatní zakázáno ───────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
