rules_version = '2';
// UFO: Cosmic Clash — Firestore Security Rules
// Autor: Alexandre Basseville

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: je volající admin? ───────────────────────────────────────
    function isAdmin() {
      return request.auth != null
          && request.auth.uid == "eWJmAYdCNbOwAb7OXD5T7C6S2zQ2";
    }

    // ── Veřejné profily uživatelů ────────────────────────────────────────
    match /users/{userId} {
      allow read:   if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && request.auth.uid == userId;
    }

    // ── Herní profily ufonů ──────────────────────────────────────────────
    // update: hráč může měnit jen sebe, admin může měnit kohokoliv
    match /aliens/{userId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
                    && (request.auth.uid == userId || isAdmin());
    }

    // ── Tréninkové session ───────────────────────────────────────────────
    match /trainingSessions/{sessionId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read, update: if request.auth != null
                          && resource.data.userId == request.auth.uid;
    }

    // ── Záznamy soubojů ──────────────────────────────────────────────────
    match /battles/{battleId} {
      allow create: if request.auth != null
                    && request.resource.data.attackerId == request.auth.uid;
      allow read:   if request.auth != null
                    && (resource.data.attackerId == request.auth.uid
                        || resource.data.defenderId == request.auth.uid);
    }

    // ── Katalog předmětů (items) ─────────────────────────────────────────
    // Čtení: každý přihlášený hráč
    // Zápis (update bonusů a cen): pouze admin
    match /items/{itemId} {
      allow read:   if request.auth != null;
      allow write:  if isAdmin();
    }

    // ── Inventář hráče ───────────────────────────────────────────────────
    match /inventory/{inventoryId} {
      allow get:    if request.auth != null;
      allow list:   if request.auth != null
                    && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Výchozí: vše ostatní zakázáno ───────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
