rules_version = '2';
// UFO: Cosmic Clash — Firestore Security Rules
// Autor: Alexandre Basseville

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Veřejné profily uživatelů ────────────────────────────────────────
    // Kolekce `users` obsahuje jen metadata (uid, email, createdAt).
    // Hráč smí zapsat/přečíst pouze svůj vlastní dokument.
    // Podmínka userId == uid chrání před zápisem pod cizím UID.
    match /users/{userId} {
      allow read:   if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && request.auth.uid == userId;
    }

    // ── Herní profily ufonů ──────────────────────────────────────────────
    // Kolekce `aliens` je herní jádro (HP, DMG, energie, měna, …).
    //
    // create: Nový hráč může zapsat svůj profil jen pokud:
    //   1. je přihlášen (request.auth != null)
    //   2. ID dokumentu odpovídá jeho UID (wildcardový {userId})
    //   3. pole userId v dokumentu také odpovídá jeho UID
    //      → nelze zapsat pod cizím UID ani s podvrženým userId polem
    //
    // read:   Každý přihlášený hráč může číst profily ostatních —
    //         potřebné pro matchmaking (hledání soupeřů dle levelu).
    //
    // update: Hráč smí měnit pouze svůj vlastní profil.
    match /aliens/{userId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && request.auth.uid == userId;
    }

    // ── Tréninkové session ───────────────────────────────────────────────
    // create: Hráč smí vytvořit session pouze pro sebe (userId == uid).
    // read/update: Pouze vlastník session.
    match /trainingSessions/{sessionId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read, update: if request.auth != null
                          && resource.data.userId == request.auth.uid;
    }

    // ── Záznamy soubojů ──────────────────────────────────────────────────
    // create: Hráč smí vytvořit záznam jen jako útočník (attackerId == uid).
    // read:   Hráč smí číst záznamy kde figuruje jako útočník nebo obránce.
    match /battles/{battleId} {
      allow create: if request.auth != null
                    && request.resource.data.attackerId == request.auth.uid;
      allow read:   if request.auth != null
                    && (resource.data.attackerId == request.auth.uid
                        || resource.data.defenderId == request.auth.uid);
    }

    // ── Katalog předmětů (items) ─────────────────────────────────────────
    // Globální katalog zbraní a brnění — čtení pro všechny přihlášené hráče.
    // Zápis (create/update/delete) je zakázán z klienta — spravuje se ručně
    // přes Firebase konzoli nebo Cloud Functions (budoucí admin panel).
    match /items/{itemId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }
        // ── Inventář hráče ───────────────────────────────────────────────────
    // Každý item v inventáři patří jednomu hráči.
    // get:    Povolen pro přihlášeného hráče kvůli kontrole duplicity v transakci.
    // list:   Hráč smí listovat pouze své vlastní itemy.
    // create: Hráč smí vytvořit pouze svůj vlastní item v inventáři.
    // update/delete: Z klienta zakázáno.
    match /inventory/{inventoryId} {
      allow get: if request.auth != null;

      allow list: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      allow update, delete: if false;
    }

    // ── Výchozí: vše ostatní zakázáno ───────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
